# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Recommended while testing. Leave empty to register commands globally.
DISCORD_GUILD_ID=

# Public HTTPS address of this bot, with no trailing slash.
# Example: https://royal-guard-bot.up.railway.app
PUBLIC_BASE_URL=
PORT=3000

# Roblox OAuth application
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# Must exactly match the callback configured in Roblox Creator Hub.
ROBLOX_OAUTH_REDIRECT_URI=https://YOUR-DOMAIN/oauth/callback

# Roblox Open Cloud API key with group read/write permissions.
ROBLOX_OPEN_CLOUD_KEY=

# Shared secret used by the optional Roblox verification game script.
GAME_VERIFICATION_SECRET=replace-with-a-long-random-secret

# Optional legacy cookie used only by /exile because Roblox Open Cloud does not
# currently expose a dedicated kick-member endpoint. Leave blank to disable /exile.
ROBLOX_SECURITY_COOKIE=

# Storage
DATABASE_PATH=./data/royal-guard.sqlite
